@page
@model SignupModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title mb-3">Create Owner Account</h2>
                    <p class="text-muted">Create a login for an owner to view their levy statements and payments.</p>

                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-info">@Model.Message</div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Unit number</label>
                            <input class="form-control" asp-for="UnitNumber" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Owner name</label>
                            <input class="form-control" asp-for="OwnerName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Invite code</label>
                            <input class="form-control" asp-for="InviteCode" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Username (owner email address)</label>
                            <input class="form-control" asp-for="Username" type="email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Cellphone number</label>
                            <input class="form-control" asp-for="CellphoneNumber" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input class="form-control" type="password" asp-for="Password" />
                            <div class="form-text">Use at least 8 characters, including letters, numbers, and special characters.</div>
                        </div>
                        <button class="btn btn-success w-100" type="submit">Create account</button>
                    </form>

                    <div class="mt-3 text-center">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-page="/Login" class="ms-1">Go to login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
